  "deps_out": ["src/cli/report.ts", "src/cli/doctor.ts", "src/cli/dq-explain.ts", "src/cli/schema-check.ts", "src/cli/enum-check.ts", "src/cli/init.ts", "src/cli/snapshot.ts", "qeg-report-action/action.yml"],
  "deps_in": ["docs/spec/index.md", "docs/requirements.md", "docs/project/runbook.md", "docs/project/evaluation.md"],
  "risks": ["report step が直接失敗すると GitHub Actions の汎用 exit code 表示に戻り、累積不足の可視性が落ちる"],
  "tests": ["npm run typecheck", "npm run schema-check", "npm run enum-check", "npm run explain -- DQ-15", "npm run doctor -- fixtures/positive-release-go", "npm run snapshot -- fixtures/positive-release-go"]
}
