{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/test-placement-plan.schema.json",
  "title": "Test Placement Plan",
  "type": "object",
  "required": ["metadata", "obligations", "placements"],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "shared-defs.schema.json#/$defs/metadata" },
    "obligations": {
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },
    "placements": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement" }
    },
    "placement_changes": {
      "type": "array",
      "items": { "$ref": "#/$defs/placement_change" }
    },
    "manual_case_inventory": {
      "$ref": "#/$defs/manual_case_inventory"
    }
  },
  "$defs": {
    "obligation": {
      "type": "object",
      "required": [
        "id",
        "requirementIds",
        "riskIds",
        "failureModeIds",
        "changedCodeIds",
        "priority",
        "riskPriorityIndex",
        "gateRelevance",
        "traceability"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "requirementIds": { "type": "array", "items": { "type": "string" } },
        "riskIds": { "type": "array", "items": { "type": "string" } },
        "failureModeIds": { "type": "array", "items": { "type": "string" } },
        "changedCodeIds": { "type": "array", "items": { "type": "string" } },
        "priority": { "$ref": "shared-defs.schema.json#/$defs/priority" },
        "riskPriorityIndex": { "type": "number", "minimum": 0 },
        "gateRelevance": { "enum": ["informational", "advisory", "blocking"] },
        "traceability": { "$ref": "shared-defs.schema.json#/$defs/traceability" }
      }
    },
    "placement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title",
        "traceability",
        "sourceArtifactIds",
        "obligationId",
        "primaryLayer",
        "disposition",
        "gateRelevance",
        "candidateScores",
        "selectedTestIds"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "kind": { "const": "test_placement" },
        "title": { "type": "string" },
        "traceability": { "$ref": "shared-defs.schema.json#/$defs/traceability" },
        "sourceArtifactIds": { "type": "array", "items": { "type": "string" } },
        "obligationId": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "primaryLayer": { "$ref": "shared-defs.schema.json#/$defs/placementLayer" },
        "disposition": { "enum": ["reuse", "adapt", "add", "manual-only", "blocked"] },
        "gateRelevance": { "enum": ["informational", "advisory", "blocking"] },
        "candidateScores": { "type": "array", "items": { "type": "object" } },
        "selectedTestIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "placement_change": {
      "type": "object",
      "required": [
        "id",
        "subject_id",
        "from_layer",
        "to_layer",
        "replacement_ids",
        "evidence_refs",
        "policy_ref",
        "decided_by",
        "decided_at",
        "reversible",
        "revert_condition"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "subject_id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "from_layer": { "$ref": "shared-defs.schema.json#/$defs/placementChangeLayer" },
        "to_layer": { "$ref": "shared-defs.schema.json#/$defs/placementChangeLayer" },
        "replacement_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/evidenceRef" }
        },
        "policy_ref": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_at": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
        "reversible": { "const": true },
        "revert_condition": { "type": "string", "minLength": 1 }
      }
    },
    "manual_case_inventory": {
      "type": "object",
      "required": ["previous_subject_ids", "current_subject_ids", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "previous_subject_ids": {
          "type": "array",
          "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
        },
        "current_subject_ids": {
          "type": "array",
          "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
        },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
        }
      }
    }
  }
}
