{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/retention.schema.json",
  "title": "Retention",
  "type": "object",
  "required": [
    "retentionPeriod",
    "retentionOwner",
    "storageLocation",
    "contentHash",
    "capturedAt",
    "tamperEvidence",
    "reverificationMethod",
    "sourceRefs",
    "storageClassification"
  ],
  "additionalProperties": false,
  "properties": {
    "retentionPeriod": { "type": "string", "minLength": 1 },
    "retentionOwner": { "type": "string", "minLength": 1 },
    "storageLocation": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "minLength": 1 },
    "capturedAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
    "tamperEvidence": { "type": "string", "minLength": 1 },
    "reverificationMethod": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
    },
    "storageClassification": { "$ref": "shared-defs.schema.json#/$defs/storageClassification" }
  }
}