{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/execution.schema.json",
  "title": "Normal execution qualification",
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "revision": { "type": "string", "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" } },
    "target": {
      "type": "object", "required": ["projectId", "buildId", "revision", "environmentId"], "additionalProperties": false,
      "properties": { "projectId": { "$ref": "#/$defs/text" }, "buildId": { "$ref": "#/$defs/text" },
        "revision": { "$ref": "#/$defs/revision" }, "environmentId": { "$ref": "#/$defs/text" } }
    },
    "verifiedRef": {
      "type": "object", "required": ["id", "path", "contentHash", "revision"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/text" }, "path": { "$ref": "#/$defs/text" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "revision": { "$ref": "#/$defs/revision" } }
    },
    "identity": {
      "type": "object", "required": ["producer", "projectId", "featureId", "caseId"], "additionalProperties": false,
      "properties": { "producer": { "$ref": "#/$defs/text" }, "projectId": { "$ref": "#/$defs/text" },
        "featureId": { "$ref": "#/$defs/text" }, "caseId": { "$ref": "#/$defs/text" } }
    },
    "context": {
      "type": "object", "required": ["projectId", "environmentId", "producerVersion"], "additionalProperties": false,
      "properties": { "projectId": { "$ref": "#/$defs/text" }, "environmentId": { "$ref": "#/$defs/text" }, "producerVersion": { "$ref": "#/$defs/text" } }
    },
    "policy": {
      "type": "object", "required": ["target", "maxEvidenceAgeHours", "buildBindingRef", "sourceRefs"], "additionalProperties": false,
      "properties": { "target": { "$ref": "#/$defs/target" }, "maxEvidenceAgeHours": { "type": "number", "exclusiveMinimum": 0 },
        "buildBindingRef": { "$ref": "#/$defs/verifiedRef" }, "sourceRefs": { "$ref": "#/$defs/sources" } }
    },
    "status": { "enum": ["pass", "fail", "skipped", "blocked", "cancelled", "unknown", "running"] },
    "execution": {
      "type": "object", "required": ["executionVersion", "testId", "identity", "producerVersion", "runId", "target", "completedAt", "status", "executionMode", "rawArtifactRef"], "additionalProperties": false,
      "properties": {
        "executionVersion": { "const": "qeg-execution/v1" }, "testId": { "$ref": "#/$defs/text" }, "identity": { "$ref": "#/$defs/identity" },
        "producerVersion": { "$ref": "#/$defs/text" }, "runId": { "$ref": "#/$defs/text" }, "target": { "$ref": "#/$defs/target" },
        "completedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "status": { "$ref": "#/$defs/status" }, "executionMode": { "enum": ["real", "mock"] },
        "rawArtifactRef": { "$ref": "#/$defs/verifiedRef" }, "historySourceRefs": { "$ref": "#/$defs/sources" }
      }
    },
    "accounting": {
      "type": "object", "required": ["evaluatedAt", "selections"], "additionalProperties": false,
      "properties": {
        "evaluatedAt": { "type": "string" }, "target": { "$ref": "#/$defs/target" },
        "selections": { "type": "array", "items": {
          "type": "object", "required": ["testId", "reason", "consecutivePasses", "excluded"], "additionalProperties": false,
          "properties": {
            "testId": { "$ref": "#/$defs/text" }, "selectedEvidenceId": { "$ref": "#/$defs/text" }, "selectedRunId": { "$ref": "#/$defs/text" },
            "selectedStatus": { "$ref": "#/$defs/status" }, "reason": { "$ref": "#/$defs/text" }, "consecutivePasses": { "type": "integer", "minimum": 0 },
            "excluded": { "type": "array", "items": { "type": "object", "required": ["evidenceId", "reason"], "additionalProperties": false,
              "properties": { "evidenceId": { "$ref": "#/$defs/text" }, "reason": { "$ref": "#/$defs/text" } } } }
          }
        } }
      }
    }
  }
}
