{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/gate-policy.schema.json",
  "title": "Gate Policy",
  "type": "object",
  "required": [
    "policyId",
    "policyHash",
    "profile",
    "effectiveDate",
    "approver",
    "sourceRefs",
    "dqScope",
    "exitCodePolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "policyId": { "type": "string", "minLength": 1 },
    "policyHash": { "type": "string", "minLength": 1 },
    "profile": { "$ref": "shared-defs.schema.json#/$defs/gateProfile" },
    "effectiveDate": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
    "approver": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
    },
    "dqScope": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/disqualificationCode" }
    },
    "exitCodePolicy": { "$ref": "shared-defs.schema.json#/$defs/exitCodePolicy" },
    "placementRetirementPolicy": { "$ref": "#/$defs/placementRetirementPolicy" }
  },
  "$defs": {
    "placementRetirementPolicy": {
      "type": "object",
      "required": ["minEvidenceStrength", "minConsecutiveGreen", "requireRiskCoverage", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "minEvidenceStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "minConsecutiveGreen": { "type": "integer", "minimum": 0 },
        "requireRiskCoverage": { "type": "boolean" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
        }
      }
    },
    "gatePolicyProposal": {
      "type": "object",
      "required": ["proposalId", "producer", "proposedPolicy", "rationale", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "proposalId": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "producer": { "enum": ["rand", "ctg", "mbb", "hate"] },
        "proposedPolicy": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
        },
        "policyHash": { "type": "string", "minLength": 1 }
      }
    }
  }
}
