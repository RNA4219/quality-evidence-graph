{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/waiver.schema.json",
  "title": "Waiver",
  "type": "object",
  "required": [
    "id",
    "linkedRiskIds",
    "approver",
    "approvalAuthority",
    "reason",
    "expiry",
    "impactScope",
    "rollbackOrContainment",
    "followUpOwner",
    "recheckCondition",
    "sourceRefs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
    "linkedRiskIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
    },
    "linkedTestIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
    },
    "approver": { "type": "string", "minLength": 1 },
    "approvalAuthority": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "expiry": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
    "impactScope": { "type": "string", "minLength": 1 },
    "rollbackOrContainment": { "type": "string", "minLength": 1 },
    "followUpOwner": { "type": "string", "minLength": 1 },
    "recheckCondition": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
    },
    "valid": { "type": "boolean" },
    "invalidReason": { "type": "string" }
  }
}
