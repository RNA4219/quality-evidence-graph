{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/shared-defs.schema.json",
  "title": "Quality Evidence Graph Shared Definitions",
  "type": "object",
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:(rand|ctg|mbb|hate|qeg):)?[^:\\s][^\\s]*$"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "severity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "priority": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "gateProfile": {
      "enum": ["lean", "standard", "strict", "ipo_controlled"]
    },
    "gateVerdict": {
      "enum": ["go", "conditional_go", "no_go", "disqualified"]
    },
    "disqualificationCode": {
      "enum": [
        "DQ-01",
        "DQ-02",
        "DQ-03",
        "DQ-04",
        "DQ-05",
        "DQ-06",
        "DQ-07",
        "DQ-08",
        "DQ-09",
        "DQ-10",
        "DQ-11",
        "DQ-12",
        "DQ-13",
        "DQ-14",
        "DQ-15",
        "DQ-16",
        "DQ-17"
      ]
    },
    "packagePhase": {
      "enum": ["implementation_preparation", "pre_release_review", "release_decision"]
    },
    "storageClassification": {
      "enum": ["immutable", "append_only", "versioned", "mutable", "unknown"]
    },
    "placementLayer": {
      "enum": [
        "unit",
        "integration",
        "system",
        "e2e",
        "manual-scripted",
        "manual-exploratory",
        "spec-clarification"
      ]
    },
    "placementChangeLayer": {
      "enum": [
        "unit",
        "integration",
        "system",
        "e2e",
        "manual-scripted",
        "manual-exploratory",
        "spec-clarification",
        "automated"
      ]
    },
    "sourceRef": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "excerptHash": { "type": "string" },
        "revision": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["sourceRefs", "assumptions", "confidence"],
      "additionalProperties": false,
      "properties": {
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": ["id", "adapter", "kind", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "adapter": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string" },
        "contentHash": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["qegVersion", "runId", "createdAt", "profile", "inputArtifacts"],
      "additionalProperties": false,
      "properties": {
        "qegVersion": { "const": "0.1" },
        "runId": { "$ref": "#/$defs/stableId" },
        "createdAt": { "$ref": "#/$defs/isoDateTime" },
        "baseRef": { "type": "string" },
        "headRef": { "type": "string" },
        "repoRoot": { "type": "string" },
        "profile": { "$ref": "#/$defs/gateProfile" },
        "policyId": { "type": "string" },
        "policyHash": { "type": "string" },
        "inputArtifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        },
        "producerChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/producerCheckRef" }
        },
        "workflowRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/stableId" },
              "kind": {
                "enum": [
                  "birdseye-index",
                  "birdseye-capsule",
                  "task-seed",
                  "acceptance-template"
                ]
              },
              "path": { "type": "string", "minLength": 1 },
              "nodeId": { "type": "string" },
              "contentHash": { "type": "string" }
            }
          }
        }
      }
    },
    "producerCheckRef": {
      "type": "object",
      "required": ["id", "producer", "name", "conclusion"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "producer": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "conclusion": {
          "enum": [
            "success",
            "failure",
            "neutral",
            "cancelled",
            "timed_out",
            "action_required",
            "skipped",
            "unknown"
          ]
        },
        "readinessStatus": {
          "enum": [
            "passed",
            "passed_with_risk",
            "needs_review",
            "blocked_input",
            "failed",
            "unknown"
          ]
        },
        "headSha": { "type": "string" },
        "runId": { "type": "string" },
        "url": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      }
    },
    "exitCodePolicy": {
      "type": "object",
      "required": ["go", "conditional_go", "no_go", "disqualified"],
      "additionalProperties": false,
      "properties": {
        "go": { "const": 0 },
        "conditional_go": { "const": 2 },
        "no_go": { "const": 2 },
        "disqualified": { "const": 2 }
      }
    },
    "controlRoles": {
      "type": "object",
      "required": ["producer", "reviewer", "approver", "waiverApprover", "releaseOwner"],
      "additionalProperties": false,
      "properties": {
        "producer": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "approver": { "type": "string", "minLength": 1 },
        "waiverApprover": { "type": "string", "minLength": 1 },
        "releaseOwner": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["id", "path", "evidenceKind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "excerptHash": { "type": "string" },
        "revision": { "type": "string" },
        "label": { "type": "string" },
        "evidenceKind": {
          "enum": ["code", "spec", "test_result", "coverage", "sarif", "human_review", "audit", "policy"]
        },
        "capturedAt": { "$ref": "#/$defs/isoDateTime" }
      }
    }
  }
}
