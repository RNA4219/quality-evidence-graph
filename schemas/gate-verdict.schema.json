{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/gate-verdict.schema.json",
  "title": "Gate Verdict",
  "type": "object",
  "required": [
    "metadata",
    "verdict",
    "reasons",
    "disqualifications",
    "blockers",
    "residualRisks",
    "requiredHumanReview"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": { "$ref": "shared-defs.schema.json#/$defs/metadata" },
    "verdict": { "$ref": "shared-defs.schema.json#/$defs/gateVerdict" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "disqualifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/disqualification" }
    },
    "blockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "residualRisks": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
    },
    "requiredHumanReview": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
    }
  },
  "$defs": {
    "disqualification": {
      "type": "object",
      "required": ["code", "message", "nodeIds", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "DQ-01",
            "DQ-02",
            "DQ-03",
            "DQ-04",
            "DQ-05",
            "DQ-06",
            "DQ-07",
            "DQ-08",
            "DQ-09",
            "DQ-10",
            "DQ-11",
            "DQ-12",
            "DQ-13",
            "DQ-14",
            "DQ-15",
            "DQ-16",
            "DQ-17"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "nodeIds": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
        }
      }
    },
    "blocker": {
      "type": "object",
      "required": ["id", "message", "riskIds", "sourceRefs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "message": { "type": "string", "minLength": 1 },
        "riskIds": { "type": "array", "items": { "type": "string" } },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
        }
      }
    }
  }
}
