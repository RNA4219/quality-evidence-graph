{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/resilience-normalize-context.schema.json",
  "title": "QEG Resilience Evidence Normalization Context",
  "type": "object",
  "required": ["node", "testId", "environment", "environmentId", "adapterVersion", "targetRevision", "evidenceRefs", "signalManifest"],
  "additionalProperties": false,
  "properties": {
    "node": {
      "type": "object",
      "required": ["id", "title", "traceability", "sourceArtifactIds"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1 },
        "traceability": { "$ref": "reliability.schema.json#/$defs/traceabilityWithSource" },
        "sourceArtifactIds": { "type": "array", "minItems": 1, "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" } }
      }
    },
    "testId": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
    "environment": { "$ref": "reliability.schema.json#/$defs/resilienceEnvironment" },
    "environmentId": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "targetRevision": { "$ref": "reliability.schema.json#/$defs/gitObjectId" },
    "experimentId": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
    "attempt": { "type": "integer", "minimum": 1 },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startedAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
        "endedAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
        "status": { "$ref": "reliability.schema.json#/$defs/resilienceEvidenceStatus" },
        "steadyStateConfirmed": { "type": "boolean" },
        "fault": { "type": "object" },
        "abortRecord": { "type": "object" },
        "recovered": { "type": "boolean" },
        "recoveryConfirmedAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
        "recoveryDurationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "observed": {
      "type": "object",
      "required": ["requestCount", "errorRate", "latencyP95Ms", "saturationPct", "duplicateSideEffects", "dataInconsistencies"],
      "additionalProperties": false,
      "properties": {
        "requestCount": { "type": "integer", "minimum": 0 },
        "errorRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "latencyP95Ms": { "type": "number", "minimum": 0 },
        "saturationPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "duplicateSideEffects": { "type": "integer", "minimum": 0 },
        "dataInconsistencies": { "type": "integer", "minimum": 0 }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "reliability.schema.json#/$defs/signalEvidenceRef" } },
    "signalManifest": { "$ref": "reliability.schema.json#/$defs/signalManifest" }
  }
}
