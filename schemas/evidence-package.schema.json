{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/evidence-package.schema.json",
  "title": "Evidence Package",
  "type": "object",
  "required": [
    "id",
    "createdAt",
    "createdBy",
    "inputArtifactHashes",
    "qegOutputs",
    "gatePolicy",
    "waivers",
    "approvalEvidence",
    "manualEvidence",
    "retention",
    "sourceRefs",
    "phase",
    "evidencePackageHash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
    "createdAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
    "createdBy": { "type": "string", "minLength": 1 },
    "inputArtifactHashes": {
      "type": "array",
      "items": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" }
    },
    "qegOutputs": {
      "type": "object",
      "required": ["qegBundle", "testPlacementPlan", "gateVerdict", "qualityEvidenceRecord"],
      "additionalProperties": false,
      "properties": {
        "qegBundle": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" },
        "testPlacementPlan": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" },
        "gateVerdict": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" },
        "qualityEvidenceRecord": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" },
        "markdownSummary": { "$ref": "shared-defs.schema.json#/$defs/artifactRef" }
      }
    },
    "gatePolicy": { "$ref": "gate-policy.schema.json" },
    "gatePolicyProposals": {
      "type": "array",
      "items": { "$ref": "gate-policy.schema.json#/$defs/gatePolicyProposal" }
    },
    "waivers": {
      "type": "array",
      "items": { "$ref": "waiver.schema.json" }
    },
    "approvalEvidence": {
      "type": "array",
      "items": { "$ref": "approval-evidence.schema.json" }
    },
    "manualEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["executedCaseId", "result", "expectedResult", "oracleRefs", "traceTo", "evidenceRefs"],
        "additionalProperties": false,
        "properties": {
          "executedCaseId": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
          "result": { "enum": ["pass", "fail", "blocked", "skipped"] },
          "expectedResult": { "type": "string", "minLength": 1 },
          "oracleRefs": {
            "type": "array",
            "items": { "$ref": "shared-defs.schema.json#/$defs/evidenceRef" }
          },
          "traceTo": {
            "type": "array",
            "items": { "$ref": "shared-defs.schema.json#/$defs/stableId" }
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "$ref": "shared-defs.schema.json#/$defs/evidenceRef" }
          },
          "reviewerNote": { "type": "string" }
        }
      }
    },
    "retention": { "$ref": "retention.schema.json" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
    },
    "phase": { "$ref": "shared-defs.schema.json#/$defs/packagePhase" },
    "evidencePackageHash": { "type": "string", "minLength": 1 },
    "controlRoles": { "$ref": "shared-defs.schema.json#/$defs/controlRoles" }
  }
}
