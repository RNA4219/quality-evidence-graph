{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-harness.dev/schemas/qeg/approval-evidence.schema.json",
  "title": "Approval Evidence",
  "type": "object",
  "required": [
    "id",
    "approver",
    "roleOrAuthority",
    "approvedDecision",
    "approvedAt",
    "policyId",
    "policyHash",
    "sourceRefs",
    "evidencePackageHash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "shared-defs.schema.json#/$defs/stableId" },
    "approver": { "type": "string", "minLength": 1 },
    "roleOrAuthority": { "type": "string", "minLength": 1 },
    "approvedDecision": { "type": "string", "minLength": 1 },
    "approvedAt": { "$ref": "shared-defs.schema.json#/$defs/isoDateTime" },
    "policyId": { "type": "string", "minLength": 1 },
    "policyHash": { "type": "string", "minLength": 1 },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "shared-defs.schema.json#/$defs/sourceRef" }
    },
    "evidencePackageHash": { "type": "string", "minLength": 1 }
  }
}