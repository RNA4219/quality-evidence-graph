{
  "name": "@quality-harness/quality-evidence-graph",
  "version": "0.4.0",
  "description": "Local-first Quality Evidence Graph and Test Placement Engine contracts",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "qeg": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RNA4219/quality-evidence-graph.git"
  },
  "homepage": "https://github.com/RNA4219/quality-evidence-graph#readme",
  "bugs": {
    "url": "https://github.com/RNA4219/quality-evidence-graph/issues"
  },
  "files": [
    "dist/",
    "schemas/",
    "docs/",
    "fixtures/",
    "examples/",
    "qeg-report-action/",
    "README.md",
    "README_JA.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "README_EN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run build:action",
    "typecheck": "tsc --noEmit",
    "test:types": "node node_modules/typescript/bin/tsc -p tests/type-contract/tsconfig.json && npm run build && node tests/package-smoke.mjs",
    "qeg": "node dist/cli.js",
    "validate": "node dist/cli.js validate",
    "gate": "node dist/cli.js gate",
    "record": "node dist/cli.js record",
    "report": "node dist/cli.js report",
    "doctor": "node dist/cli.js doctor",
    "explain": "node dist/cli.js explain",
    "schema-check": "node dist/cli.js schema-check",
    "enum-check": "node dist/cli.js enum-check",
    "baseline": "node dist/cli.js baseline",
    "evidence": "node dist/cli.js evidence",
    "test:runtime": "node --test tests/runtime.test.mjs tests/action-contract.test.mjs tests/remediation-gate.test.mjs tests/producer-pipeline.test.mjs tests/execution-qualification.test.mjs tests/output-publication.test.mjs tests/consumer-migration.test.mjs tests/producer-replay.test.mjs tests/transaction-regression.test.mjs tests/followup-regression.test.mjs tests/cli-boundary-regression.test.mjs tests/gate-contract-regression.test.mjs",
    "build-graph": "node dist/cli.js build-graph",
    "place-tests": "node dist/cli.js place-tests",
    "policy": "node dist/cli.js policy",
    "repro-bundle": "node dist/cli.js repro-bundle",
    "check": "node dist/cli.js check",
    "init": "node dist/cli.js init",
    "snapshot": "node dist/cli.js snapshot",
    "test": "npm run test:types && npm run test:runtime && npm run test:fixtures && npm run test:package && npm run json-check",
    "test:fixtures": "node tests/fixture-regression.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "birdseye-check": "node tools/birdseye-check.mjs",
    "json-check": "node tools/json-check.mjs",
    "build:action": "node tools/build-action.mjs",
    "test:release-lifecycle": "node tools/action-lifecycle-acceptance.mjs"
  },
  "keywords": [
    "quality-gate",
    "evidence-graph",
    "test-placement",
    "risk-based-testing",
    "sarif"
  ],
  "author": "R_N_A",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
